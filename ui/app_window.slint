import { Button, VerticalBox, ProgressIndicator, HorizontalBox, Palette, StyleMetrics } from "std-widgets.slint";

export enum UIState {
    Ready,
    Running,
    Success,
    Error,
}

export component AppWindow inherits Window {
    in-out property <UIState> state: Ready;
    in-out property <float> progress: 0.0;
    in-out property <int> pca_k: 10;

    out property <bool> show_execute: state == UIState.Ready || state == UIState.Success;
    out property <bool> show_progress: state == UIState.Running;
    out property <bool> show_response: state == UIState.Success;
    out property <bool> show_error: state == UIState.Error;

    callback exe_data_mining();

    VerticalBox {
        StyledText {
            text: @markdown("**Dados Abertos, Microdados Enem 2024:** [link](https://www.gov.br/inep/pt-br/acesso-a-informacao/dados-abertos/microdados/enem)");
        }
        StyledText {
            text: @markdown("**Dados Abertos, Microdados Censo Escolar 2024:** [link](https://www.gov.br/inep/pt-br/acesso-a-informacao/dados-abertos/microdados/censo-escolar)");
        }
        HorizontalBox {
            Text {
                text: "N° de componentes desejados: ";
                vertical-alignment: center;
            }
            Rectangle {
                border-color: Palette.foreground;
                border-width: 1px;
                clip: true;
                TextInput {
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    input-type: number;

                    function set-text() {
                        self.text = root.pca_k.to-string-unlocalized()
                    }

                    in property <int> local_pca_k: root.pca_k;
                    changed local_pca_k => {
                        self.set-text();
                    }
                    init => {
                        self.set-text();
                    }

                    function commit() {
                        if self.text.is-float() {
                            root.pca_k = max(1, round(self.text.to-float()));
                        }
                        self.text = root.pca_k.to-string-unlocalized();
                    }
                    accepted => {
                        self.commit()
                    }
                    edited => {
                        self.commit()
                    }

                    private property <length> margin: 1rem;
                    cursor-position-changed(cursor-position) => {
                        if cursor-position.x + self.x < margin {
                            self.x = - cursor-position.x + margin;
                        } else if cursor-position.x + self.x > parent.width - margin - self.text-cursor-width {
                            self.x = parent.width - cursor-position.x - margin - self.text-cursor-width;
                        }
                    }
                }
                
            }
            Button {
                height: self.min-height;
                text: "-";
                clicked => {
                    if root.pca_k > 1 {
                        root.pca_k -= 1;
                    }
                }
            }
            Button {
                height: self.min-height;
                text: "+";
                clicked => {
                    root.pca_k += 1;
                }
            }
        }
        Button {
            visible: show_execute;
            text: "Executar mineração";
            clicked => {
                root.exe_data_mining();
            }
        }
        HorizontalBox {
            visible: show_progress;
            Text {
                text: "\{root.progress * 100}%";
            }
            ProgressIndicator {
                progress: progress;
            }
        }
    }
}