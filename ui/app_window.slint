import {
    Button,
    VerticalBox,
    ProgressIndicator,
    HorizontalBox,
    ScrollView,
    StandardTableView,
} from "std-widgets.slint";
import { CompIntInput } from "comp_int_input.slint";

import { CompClearDialog, ClearItemStruct } from "comp_clear_dialog.slint";
export { CompClearDialog, ClearItemStruct }
export enum UIState {
    Ready,
    Running,
    Success,
    Error,
}

export component AppWindow inherits Window {
    in-out property <[[StandardListViewItem]]> response;
    in-out property <bool> dialog_open: false;
    in-out property <UIState> state: UIState.Ready;
    in-out property <float> progress: 0.0;
    out property <int> pca_k: 70;
    out property <int> kmpp_k: 6;
    out property <int> kmpp_i: 10;

    callback exe_data_mining();
    callback open_clear_dialog();
    callback download_response();
    callback download_clusters();
    callback sort_slvi([[StandardListViewItem]], int, bool) -> [[StandardListViewItem]];

    title: "Mineração INEP";
    maximized: true;
    VerticalBox {
        StyledText {
            text: @markdown("**[Dados Abertos, Microdados Enem 2024](https://www.gov.br/inep/pt-br/acesso-a-informacao/dados-abertos/microdados/enem)**");
        }

        StyledText {
            text: @markdown("**[Dados Abertos, Microdados Censo Escolar 2024](https://www.gov.br/inep/pt-br/acesso-a-informacao/dados-abertos/microdados/censo-escolar)**");
        }

        CompIntInput {
            text: @markdown("**PCA:** N° de componentes: ");
            enabled: state == UIState.Ready;
            value: root.pca_k;
        }

        CompIntInput {
            text: @markdown("**K-Means++:** N° de conjuntos: ");
            enabled: state == UIState.Ready;
            value: root.kmpp_k;
        }

        CompIntInput {
            text: @markdown("**K-Means++:** N° de iterações: ");
            enabled: state == UIState.Ready;
            value: root.kmpp_i;
        }

        Button {
            enabled: state != UIState.Running;
            text: "Executar mineração";
            clicked => {
                if state == UIState.Ready {
                    root.progress = 0.0;
                    root.exe_data_mining();
                } else {
                    root.open_clear_dialog();
                }
            }
        }

        HorizontalBox {
            visible: state == UIState.Running;
            Text {
                text: "\{round(root.progress * 100)}%";
            }

            ProgressIndicator {
                progress: progress;
            }
        }

        HorizontalBox {
            Button {
                visible: state == UIState.Success;
                text: "⬇ Baixar Resposta";
                clicked => { root.download_response(); }
            }

            Button {
                visible: state == UIState.Success;
                text: "⬇ Baixar Clusters";
                clicked => { root.download_clusters(); }
            }
        }

        StandardTableView {
            visible: state == UIState.Success;
            rows: root.response;
            sort-ascending(col) => { root.response = root.sort_slvi(root.response, col, true); }
            sort-descending(col) => { root.response = root.sort_slvi(root.response, col, false); }
            columns: [
                { title: "CLUSTER" },
                { title: "CLUSTER_AVG_GRADE" },
                { title: "AVG_GRADE" },
                { title: "NU_ANO_CENSO" },
                { title: "NO_REGIAO" },
                { title: "CO_REGIAO" },
                { title: "NO_UF" },
                { title: "SG_UF" },
                { title: "CO_UF" },
                { title: "NO_MUNICIPIO" },
                { title: "CO_MUNICIPIO" },
                { title: "NO_REGIAO_GEOG_INTERM" },
                { title: "CO_REGIAO_GEOG_INTERM" },
                { title: "NO_REGIAO_GEOG_IMED" },
                { title: "CO_REGIAO_GEOG_IMED" },
                { title: "NO_MESORREGIAO" },
                { title: "CO_MESORREGIAO" },
                { title: "NO_MICRORREGIAO" },
                { title: "CO_MICRORREGIAO" },
                { title: "NO_DISTRITO" },
                { title: "CO_DISTRITO" },
                { title: "NO_ENTIDADE" },
                { title: "CO_ENTIDADE" },
                { title: "TP_DEPENDENCIA" },
                { title: "TP_CATEGORIA_ESCOLA_PRIVADA" },
                { title: "TP_LOCALIZACAO" },
                { title: "TP_LOCALIZACAO_DIFERENCIADA" },
                { title: "DS_ENDERECO" },
                { title: "NU_ENDERECO" },
                { title: "DS_COMPLEMENTO" },
                { title: "NO_BAIRRO" },
                { title: "CO_CEP" },
                { title: "NU_DDD" },
                { title: "NU_TELEFONE" },
                { title: "TP_SITUACAO_FUNCIONAMENTO" },
                { title: "CO_ORGAO_REGIONAL" },
            ];
        }
    }
}
